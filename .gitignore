# Secrets — never commit
tokens.env

# Operator arming env for the rotate-tick launchd agent — machine-local paths
# and arming decisions (see launchd/rotate-tick.env.local.example).
launchd/rotate-tick.env.local

# Bridge (bun/node) build artifacts
node_modules
bun.lock
!bridge/bun.lock
!codex-bridge/bun.lock

# OS / editor cruft
.DS_Store
*.swp

# Settings merge leftovers
.claude/settings.json.new

# Per-teammate git worktrees (CTO provisions before spawn;
# never tracked in the integration tree).
.claude/worktrees/

# Failover default-split snapshot — runtime state captured by swarm-account.sh at
# the first failover so --reset can restore the operator's intended account split.
# Machine-local, never tracked (ADR-0018).
.swarm-accounts-default

# Account-usage verifier snapshot — profile labels and usage counters captured
# on this host; runtime state, never source.
.swarm-account-usage-baseline
