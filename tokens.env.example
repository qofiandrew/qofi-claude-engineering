# tokens.env — per-repo Discord bot tokens. Keep OUT of git (chmod 600).
# One bot per repo = one identity per channel, so the leads stay distinguishable.
# Names here must match the TOKEN_VAR_NAME column in swarm.conf.
#
# export BOT_ACME="..."
# export BOT_BEACON="..."
# export BOT_LEDGER="..."
#
# Do NOT put ANTHROPIC_API_KEY here (or anywhere the lead's shell sources) —
# swarm-up.sh unsets it on purpose so the leads run on your Max subscription.
