#!/usr/bin/env bash
# SWARM-MANAGED pre-commit (anti-secret-only — tooling/source repo variant)
#
# Variant of the standard SWARM-MANAGED pre-commit, with the docs-touch gate
# REMOVED so it doesn't misfire on tooling/source-repo commits that
# legitimately touch only code or config (no docs needed). The anti-secret
# pattern scan is retained — cheap insurance against committing a secret
# into the source repo's history.
#
# Use this variant in repos that are:
#   - the swarm engineering source repo (qofi-claude-engineering itself)
#   - any tooling / infrastructure repo whose normal commit cadence doesn't
#     pair source changes with docs changes
#
# Use the standard SWARM-MANAGED pre-commit (full doc + secret gate) in
# stamped swarm engineering repos — docs-touch enforcement is part of the
# doctrine there.
#
# swarm-lib.sh recognizes this variant by its distinct marker on line 2 and
# will NOT overwrite it back to the standard hook on sync / init / onboard.
#
# Bypass: `git commit --no-verify` skips this hook. CLAUDE.md §Verification
# already forbids that. We can't mechanically prevent it; we can only refuse
# to be the one who uses it.

set -uo pipefail

STAGED="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"
if [ -z "$STAGED" ]; then
  # Nothing staged (initial commit? amend with nothing?). Nothing to gate.
  exit 0
fi

# Get the staged diff (added/changed lines only), zero context.
DIFF="$(git diff --cached -U0 --no-color 2>/dev/null || true)"

# Each entry: pattern_name|regex. Order doesn't matter; we report all hits.
patterns_check() {
  local name="$1" rx="$2"
  # Only look at added lines (start with '+' but not '+++'). The trailing
  # `grep -Eo -- "$rx"` uses `--` so that patterns starting with `-----` (PEM
  # private keys) are not mistaken for grep options.
  local hit
  hit="$(printf '%s\n' "$DIFF" | grep -nE '^\+' | grep -vE '^\+\+\+ ' | grep -Eo -- "$rx" | head -1 || true)"
  if [ -n "$hit" ]; then
    local files
    files="$(printf '%s\n' "$STAGED" | tr '\n' ' ')"
    {
      echo "pre-commit: BLOCKED — staged content matches secret pattern '$name'."
      echo "  files in this commit: $files"
      echo "  (matched value NOT printed; rotate the secret if it was a real one)"
    } >&2
    return 1
  fi
  return 0
}

# High-confidence secret shapes. Conservative — false positives are operator
# annoyance; false negatives are real leaks. Bias towards a few solid catches
# over a wide net that cries wolf.
FOUND_SECRET=0
patterns_check "Discord bot token" 'MT[A-Za-z0-9._-]{40,}'                                      || FOUND_SECRET=1
patterns_check "AWS access key"    'AKIA[0-9A-Z]{16}'                                           || FOUND_SECRET=1
patterns_check "GitHub token"      'gh[pousr]_[A-Za-z0-9]{36}'                                  || FOUND_SECRET=1
patterns_check "Slack token"       'xox[baprs]-[0-9]{10,}-[a-zA-Z0-9-]+'                        || FOUND_SECRET=1
patterns_check "PEM private key"   '-----BEGIN [A-Z ]*PRIVATE KEY-----'                         || FOUND_SECRET=1
patterns_check "JWT-shaped"        'eyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}' || FOUND_SECRET=1

if [ "$FOUND_SECRET" -ne 0 ]; then
  {
    echo ""
    echo "If any matched value is a REAL secret: rotate it first, then unstage"
    echo "the change, then re-commit without it. Per CLAUDE.md §Secrets,"
    echo "exposed secrets are flagged to the operator immediately."
  } >&2
  exit 1
fi

exit 0
