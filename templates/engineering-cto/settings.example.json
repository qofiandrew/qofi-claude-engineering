{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_TEST_CMD": "npm test --silent"
  },
  "teammateMode": "in-process",
  "enabledPlugins": {
    "discord-b2b@qofi-swarm": true
  },
  "permissions": {
    "allow": [
      "mcp__plugin_discord-b2b_discord__reply",
      "Bash(git push origin worktree-*:*)",
      "Bash(git push --force-with-lease origin worktree-*:*)",
      "Bash(git push --force origin worktree-*:*)",
      "Bash(git push -f origin worktree-*:*)",
      "Bash(git push origin dev:*)"
    ],
    "deny": [
      "Bash(git push origin main*)",
      "Bash(git push *:main*)",
      "Bash(git push * main)",
      "Bash(git push *--force* main)",
      "Bash(git push *--force* main *)",
      "Bash(git push *--force* main:*)",
      "Bash(git push *--force* dev)",
      "Bash(git push *--force* dev *)",
      "Bash(git push *--force* dev:*)",
      "Bash(git push *-f * main)",
      "Bash(git push *-f * dev)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git push *--all*)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/permission-gate.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-gate.sh\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/dod-affirm.sh\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/canon-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/docs-check.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/quality-check.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-summary.sh\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/discord-reply-nudge.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-doctrine.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
