<?xml version="1.0" encoding="UTF-8"?>
<!-- TEMPLATE — do NOT load this file directly and do NOT commit a rendered copy.
     launchd does not expand $VARS or ~ in plist paths, so the absolute paths
     below are filled in PER MACHINE by bin/swarm-launchd-install.sh, which
     substitutes three placeholders into the path fields below:
        SWARM_HOME -> $SWARM_HOME          (this repo's path on this host)
        HOME       -> $HOME                (this user's home)
        TMUX_BIN   -> $(command -v tmux)   (/opt/homebrew on Apple Silicon,
                                            /usr/local on Intel)
     and writes the result to ~/Library/LaunchAgents/com.qofi.swarm-watch.plist.
     This keeps the repo username/host-agnostic — every mini renders its own. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qofi.swarm-watch</string>

  <!-- One watcher for ALL swarms. It reads $SWARM_HOME/swarm.conf and posts a
       per-channel heartbeat for each configured swarm. Absolute path required. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@@SWARM_HOME@@/bin/swarm-watch.sh</string>
  </array>

  <!-- Fire every 10s. The script is a one-shot sweep over all swarms;
       launchd supervises. The Discord PATCH is change-guarded so a
       stable state produces zero API traffic — the 10s cadence buys
       fast transition response (~10s from state change to pinned-
       heartbeat update) without rate-limit risk. Per-instance runtime
       is bounded by curl --max-time and an atomic mkdir lock prevents
       overlap if a fire ever runs long. -->
  <key>StartInterval</key>
  <integer>10</integer>

  <!-- Run on load and every boot, so it survives reboots (pair with auto-restart-after-power-loss). -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>@@HOME@@/.config/swarm/watch.log</string>
  <key>StandardErrorPath</key>
  <string>@@HOME@@/.config/swarm/watch.err</string>

  <!-- The watcher derives channel/repo/token PER SWARM from swarm.conf + tokens.env,
       so the only thing it needs here is where SWARM_HOME is, plus a few knobs.
       Bot tokens are NOT here and NOT in the script — they live in tokens.env. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>SWARM_HOME</key>
    <string>@@SWARM_HOME@@</string>
    <key>CLAUDE_PROJECTS_DIR</key>
    <string>@@HOME@@/.claude/projects</string>
    <key>SWARM_STATE_DIR</key>
    <string>@@HOME@@/.config/swarm</string>
    <key>SWARM_STALE_SECONDS</key>
    <string>300</string>
    <!-- launchd has a minimal PATH, so give tmux's absolute path. The installer
         fills this from `command -v tmux` (Apple Silicon /opt/homebrew/bin/tmux;
         Intel /usr/local/bin/tmux). -->
    <key>SWARM_TMUX_BIN</key>
    <string>@@TMUX_BIN@@</string>
    <key>SWARM_ENABLE_TYPING</key>
    <string>0</string>
  </dict>
</dict>
</plist>
