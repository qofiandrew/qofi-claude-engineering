<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qofi.swarm-watch</string>

  <!-- One watcher for ALL swarms. It reads $SWARM_HOME/swarm.conf and posts a
       per-channel heartbeat for each configured swarm. Absolute path required. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/aschettino/qofirepos/qofi-claude-engineering/bin/swarm-watch.sh</string>
  </array>

  <!-- Fire every 90s. The script is a one-shot sweep over all swarms; launchd supervises. -->
  <key>StartInterval</key>
  <integer>90</integer>

  <!-- Run on load and every boot, so it survives reboots (pair with auto-restart-after-power-loss). -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/aschettino/.config/swarm/watch.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/aschettino/.config/swarm/watch.err</string>

  <!-- The watcher derives channel/repo/token PER SWARM from swarm.conf + tokens.env,
       so the only thing it needs here is where SWARM_HOME is, plus a few knobs.
       Bot tokens are NOT here and NOT in the script — they live in tokens.env. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>SWARM_HOME</key>
    <string>/Users/aschettino/qofirepos/qofi-claude-engineering</string>
    <key>CLAUDE_PROJECTS_DIR</key>
    <string>/Users/aschettino/.claude/projects</string>
    <key>SWARM_STATE_DIR</key>
    <string>/Users/aschettino/.config/swarm</string>
    <key>SWARM_STALE_SECONDS</key>
    <string>300</string>
    <!-- launchd has a minimal PATH, so give tmux's absolute path. Verify with `which tmux`
         (Apple Silicon Homebrew is /opt/homebrew/bin/tmux; Intel is /usr/local/bin/tmux). -->
    <key>SWARM_TMUX_BIN</key>
    <string>/opt/homebrew/bin/tmux</string>
    <key>SWARM_ENABLE_TYPING</key>
    <string>0</string>
  </dict>
</dict>
</plist>
